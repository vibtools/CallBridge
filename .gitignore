# Private/internal project workspace
/project/*

# Node/Vite
node_modules/
dist/
.vite/
*.local

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Editors / OS
.DS_Store
Thumbs.db
.vscode/
.idea/

# Test/cache
coverage/
.pytest_cache/
__pycache__/
